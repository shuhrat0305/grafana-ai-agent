# Copy to .env and adjust. docker compose reads it. An empty .env still brings the
# stack up; only the agent needs a key to answer.
#
#   cp .env.example .env

# ---- the agent -------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ---- images ----------------------------------------------------------------
GRAFANA_TAG=latest
NGINX_TAG=1.30.4-alpine
MCP_TAG=latest
PDG_TAG=latest                          # prometheus-data-generator (metrics)

# ---- ports (published by nginx; Grafana is not exposed directly) -----------
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
HOST_PORT=3200                          # Grafana with the chat overlay, via nginx (use this)
PROM_PORT=9091
